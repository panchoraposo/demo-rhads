{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "devfile: Maven package (Nexus)",
      "type": "shell",
      "command": "./mvnw -s .mvn/settings.xml -DskipTests package",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "devfile: Configure Sigstore git commit signing",
      "type": "shell",
      "command": "bash .devcontainer/setup-gitsign.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "devfile: Verify Sigstore-signed HEAD",
      "type": "shell",
      "command": "bash .devcontainer/verify-gitsign.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
