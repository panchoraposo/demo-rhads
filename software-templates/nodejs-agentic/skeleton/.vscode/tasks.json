{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "devfile: npm install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "devfile: npm start",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "devfile: Configure Sigstore git commit signing",
      "type": "shell",
      "command": "bash .devcontainer/setup-gitsign.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "devfile: Verify Sigstore-signed HEAD",
      "type": "shell",
      "command": "bash .devcontainer/verify-gitsign.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
